        <mxCell id="eC5" value="loop over all batches" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#999999;fontSize=10;" edge="1" parent="1" source="C5" target="C3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1255" y="1075" /><mxPoint x="695" y="1075" /></Array></mxGeometry></mxCell>
        <mxCell id="eC6" value="finalize()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="C5" target="C6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eC7" value="pass" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="C6" target="C7"><mxGeometry relative="1" as="geometry" /></mxCell>
