  <diagram name="WSI Pipeline Architecture" id="wsi-arch-1">
    <mxGraphModel dx="2200" dy="1900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1750" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ============ TITLE ============ -->
        <mxCell id="title" value="wsi-metastasis-seg &#8212; Gigapixel WSI Tumor Segmentation Pipeline" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#1F4E79;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1620" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Governing constraint: nothing at level-0 resolution is ever materialised in full. Data moves between modules as COORDINATES; pixels are read lazily in bounded windows and discarded." style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontStyle=2;fontColor=#444444;" vertex="1" parent="1">
          <mxGeometry x="40" y="46" width="1620" height="26" as="geometry" />
        </mxCell>

        <!-- ============ LANE BACKGROUNDS ============ -->
        <mxCell id="laneA" value="STAGE A &#8212; INGEST&#10;(CPU, offline, once per slide)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F4F8FB;strokeColor=#9BB7CE;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=13;fontStyle=1;fontColor=#1F4E79;" vertex="1" parent="1">
          <mxGeometry x="40" y="85" width="1620" height="470" as="geometry" />
        </mxCell>
        <mxCell id="laneB" value="STAGE B &#8212; TRAIN&#10;(GPU, online)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F6F4FB;strokeColor=#B0A3CE;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=13;fontStyle=1;fontColor=#4B3A8C;" vertex="1" parent="1">
          <mxGeometry x="40" y="640" width="1620" height="330" as="geometry" />
        </mxCell>
        <mxCell id="laneC" value="STAGE C &#8212; INFER &amp; RECONSTRUCT&#10;(GPU, per slide)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F3FAF4;strokeColor=#95C39B;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=13;fontStyle=1;fontColor=#2D6B36;" vertex="1" parent="1">
          <mxGeometry x="40" y="1055" width="1620" height="630" as="geometry" />
        </mxCell>

        <!-- ============ STAGE A ============ -->
        <mxCell id="A1" value="Raw WSI&#10;pyramidal TIFF / SVS&#10;&#8776;30 GB uncompressed" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1">
