        <mxCell id="eC13" value="checkpoint: weights + &#964;&#10;(architecture built from CKPT config,&#10;never from the live config file)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#B85450;strokeWidth=2;fontSize=10;fontColor=#B85450;" edge="1" parent="1" source="B7" target="C4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1540" y="1020" /><mxPoint x="952" y="1020" /></Array></mxGeometry></mxCell>
        <mxCell id="eC14" value="tissue mask reused from Stage A" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#999999;fontSize=10;" edge="1" parent="1" source="A5" target="C2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1125" y="185" /><mxPoint x="1125" y="600" /><mxPoint x="20" y="600" /><mxPoint x="20" y="1170" /></Array></mxGeometry></mxCell>
        <mxCell id="Cnote" value="A HOLE in the heatmap is indistinguishable from a&#10;confident negative. No metric would ever reveal it &#8212;&#10;hence a hard assert BEFORE anything is written." style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=2;fontColor=#B85450;" vertex="1" parent="1">
          <mxGeometry x="1420" y="1295" width="230" height="70" as="geometry" />
        </mxCell>

        <!-- ============ RESOLUTION LADDER PANEL ============ -->
        <mxCell id="ladder" value="THE RESOLUTION LADDER &#8212; three resolutions in play at once&#10;&#10;Level 0 (native)   0.25 &#181;m/px (40&#215;)   90k &#215; 210k   &#8594; COORDINATE SPACE ONLY&#10;Working level      0.50 &#181;m/px (20&#215;)   45k &#215; 105k   &#8594; patch pixels, model input&#10;Thumbnail level    8.00 &#181;m/px (1.25&#215;)  2.8k &#215; 6.6k   &#8594; tissue mask, planning, QC&#10;&#10;INV-1  every persisted coordinate is in LEVEL-0 pixels&#10;INV-2  downsample factors come from the FILE, never from 2^level&#10;          (real value 1.9992175 &#8594; 205 px drift across a 105k slide)&#10;&#10;read_region(location, level, size)&#10;                &#8593;                    &#8593;&#10;        ALWAYS level-0      ALWAYS pixels AT that level" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1F4E79;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fontSize=11;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="70" y="405" width="620" height="130" as="geometry" />
        </mxCell>

