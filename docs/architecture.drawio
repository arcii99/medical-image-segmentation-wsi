        </mxCell>
        <mxCell id="A2" value="SlideReader&#10;&lt;i&gt;io/slide.py&lt;/i&gt;&#10;backend chain, RGBA&#8594;RGB on white,&#10;MPP resolved from file" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="290" y="140" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="A3" value="Thumbnail&#10;level &#8776; 8 &#181;m/px&#10;(2.8k &#215; 6.6k)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="540" y="145" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="A4" value="TissueLocalizer&#10;&lt;i&gt;preprocess/tissue.py&lt;/i&gt;&#10;1. artifact mask (ink, black) FIRST&#10;2. Otsu(saturation) &#8746; Otsu(darkness)&#10;3. floors: sat&#8805;20, grey&#8805;40&#10;4. morphology in &#181;m" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="740" y="130" width="250" height="110" as="geometry" />
        </mxCell>
        <mxCell id="A5" value="tissue_mask.png&#10;bool, thumbnail res&#10;guard: 0.01 &#8804; mean &#8804; 0.90" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1040" y="145" width="170" height="80" as="geometry" />
        </mxCell>

        <mxCell id="A6" value="Annotation XML&#10;polygon vertices&#10;groups _0/_1/_2" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="290" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="A7" value="AnnotationParser&#10;&lt;i&gt;io/annotations.py&lt;/i&gt;&#10;tumor = union(_0,_1)&#10;geom = tumor &#8722; union(_2)&#10;buffer(0) repairs self-intersections" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="290" y="285" width="230" height="100" as="geometry" />
        </mxCell>
        <mxCell id="A8" value="TumorGeometry&#10;VECTOR polygons, level-0 coords&#10;+ STRtree spatial index&#10;(never rasterised whole)" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="570" y="290" width="220" height="90" as="geometry" />
        </mxCell>

        <mxCell id="A9" value="PatchIndexer&#10;&lt;i&gt;preprocess/patching.py&lt;/i&gt;&#10;grid &#215; tissue_frac &#215; tumor_frac&#10;tumor_frac by exact POLYGON AREA&#10;(1.2 ms/patch, not 45 min/slide)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="740" y="415" width="250" height="105" as="geometry" />
        </mxCell>
        <mxCell id="A10" value="patches.parquet&#10;slide_id, x0, y0, level, size,&#10;tissue_frac, tumor_frac, split&#10;&#8776;40 B/row &#8594; 120 MB for 400 slides" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1040" y="405" width="250" height="120" as="geometry" />
        </mxCell>
        <mxCell id="A11" value="slides.parquet&#10;mpp0, level_w, residual_scale,&#10;patient_id, split, qc_flag" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1350" y="270" width="240" height="110" as="geometry" />
        </mxCell>
        <mxCell id="Anote" value="Splits assigned HERE, once,&#10;by hash(patient_id) &#8212; never&#10;recomputed at train time (BUG-007)" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=2;fontColor=#B85450;" vertex="1" parent="1">
          <mxGeometry x="1350" y="390" width="250" height="50" as="geometry" />
