        <mxCell id="eA6" value="level-0 dims (bbox check)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#999999;fontSize=10;" edge="1" parent="1" source="A2" target="A7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eA7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6C8EBF;strokeWidth=2;" edge="1" parent="1" source="A7" target="A8"><mxGeometry relative="1" as="geometry" /></mxCell>
