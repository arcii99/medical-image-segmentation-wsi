        <mxCell id="eA10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;strokeWidth=2;" edge="1" parent="1" source="A9" target="A10"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eA11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;strokeWidth=2;" edge="1" parent="1" source="A2" target="A11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="390" y="110" /><mxPoint x="1470" y="110" /></Array></mxGeometry></mxCell>

        <!-- ============ STAGE B ============ -->
        <mxCell id="B1" value="patches.parquet&#10;(coordinates only)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=13;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="700" width="160" height="90" as="geometry" />
        </mxCell>
        <mxCell id="B2" value="BalancedSampler&#10;&lt;i&gt;data/sampler.py&lt;/i&gt;&#10;1 tumor : 3 normal&#10;+ 10% boundary bucket&#10;+ hard negatives from epoch 8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="280" y="690" width="215" height="110" as="geometry" />
        </mxCell>
        <mxCell id="B3" value="PatchDataset&#10;&lt;i&gt;data/dataset.py&lt;/i&gt;&#10;LAZY read_region per index&#10;handles opened per-PID (BUG-002)&#10;&#177;128 px jitter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="545" y="690" width="225" height="110" as="geometry" />
        </mxCell>
        <mxCell id="B4" value="Augment&#10;GEOMETRIC: D4 &#8594; image + mask&#10;PHOTOMETRIC: HED jitter, blur,&#10;JPEG &#8594; image ONLY (BUG-011)&#10;assert mask &#8712; {0,1}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="820" y="690" width="255" height="110" as="geometry" />
        </mxCell>
        <mxCell id="B5" value="UNet + EfficientNet-B0&#10;6.3 M params, bf16 AMP&#10;x [16,3,512,512] &#8594; logits [16,1,512,512]&#10;encoder frozen 2 epochs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1125" y="690" width="265" height="110" as="geometry" />
        </mxCell>
        <mxCell id="B6" value="Loss = 0.5&#183;BCE(pos_weight=2)&#10;+ 0.5&#183;SoftDice (per-image)&#10;AdamW, cosine + 3ep warmup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1125" y="845" width="265" height="80" as="geometry" />
        </mxCell>
        <mxCell id="B7" value="best.pt&#10;weights + EMA + optimiser&#10;+ fitted threshold &#964;&#10;+ git SHA + dirty flag&#10;+ config + index_hash + seed" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=13;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1440" y="835" width="200" height="120" as="geometry" />
        </mxCell>
        <mxCell id="Bnote" value="&#964; is fitted on validation, NOT 0.5.&#10;Balanced sampling distorts the prior,&#10;so the cut-off must be re-fitted.&#10;&#964; travels through 5 modules &#8212; any&#10;one defaulting to 0.5 = 5&#8211;10 pt error." style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=2;fontColor=#B85450;" vertex="1" parent="1">
          <mxGeometry x="70" y="835" width="280" height="90" as="geometry" />
        </mxCell>

        <mxCell id="eB1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673A6;strokeWidth=2;" edge="1" parent="1" source="B1" target="B2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eB2" value="indices" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673A6;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="B2" target="B3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eB3" value="512&#178; patch + mask" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673A6;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="B3" target="B4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eB4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9673A6;strokeWidth=2;" edge="1" parent="1" source="B4" target="B5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eB5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#D79B00;strokeWidth=2;" edge="1" parent="1" source="B5" target="B6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eB6" value="backward" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#D79B00;fontSize=10;" edge="1" parent="1" source="B6" target="B5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1100" y="885" /><mxPoint x="1100" y="745" /></Array></mxGeometry></mxCell>
        <mxCell id="eB7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;strokeWidth=2;" edge="1" parent="1" source="B6" target="B7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eB8" value="LAZY PIXEL READ&#10;(raw WSI is a runtime dependency)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;strokeColor=#B85450;strokeWidth=2;fontSize=10;fontColor=#B85450;" edge="1" parent="1" source="A1" target="B3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="155" y="600" /><mxPoint x="657" y="600" /></Array></mxGeometry></mxCell>

        <!-- ============ STAGE C ============ -->
        <mxCell id="C1" value="Unseen WSI&#10;+ tissue mask (reused)" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="1125" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="C2" value="SlidingWindowPlanner&#10;&lt;i&gt;infer/sliding_window.py&lt;/i&gt;&#10;stride 256 (50% overlap)&#10;tissue-gated: 20k of 72k positions&#10;margin CLAMPED, never skipped&#10;chunk-aligned traversal order" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="290" y="1110" width="255" height="120" as="geometry" />
        </mxCell>
        <mxCell id="C3" value="Batched read_region&#10;batch 32, prefetch thread&#10;overlaps IO with GPU" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="595" y="1125" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="C4" value="model + sigmoid&#10;(+ optional 4&#215; D4 TTA)&#10;probs [32,1,512,512] &#8712; [0,1]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="845" y="1125" width="215" height="90" as="geometry" />
        </mxCell>

        <mxCell id="C5" value="GaussianStitcher&#10;&lt;i&gt;infer/stitch.py&lt;/i&gt;&#10;w = exp(&#8722;r&#178;/2&#963;&#178;) + 1e-3,  &#963; = S/8&#10;num += p&#183;w      (FLOAT32 zarr)&#10;den += w        (FLOAT32 zarr)&#10;written at 8&#215; downsample from L0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1110" y="1105" width="290" height="130" as="geometry" />
        </mxCell>
        <mxCell id="C6" value="Coverage assert&#10;den &lt; 1e-6 inside tissue?&#10;&#8594; raise CoverageError" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1130" y="1285" width="250" height="120" as="geometry" />
        </mxCell>
        <mxCell id="C7" value="heat = num / (den + &#949;)&#10;cast to float16 ONLY here&#10;range asserted &#8712; [0,1]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="820" y="1305" width="240" height="85" as="geometry" />
        </mxCell>
        <mxCell id="C8" value="heatmap.zarr&#10;float16, 2.0 &#181;m/px, 1024&#178; chunks&#10;148 MB (&#8776;40 MB compressed)&#10;.zattrs: mpp, downsample, &#964;,&#10;git_sha, model_run_id, stride" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=13;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="520" y="1290" width="250" height="120" as="geometry" />
        </mxCell>

        <mxCell id="C9" value="Post-processing&#10;&lt;i&gt;infer/postproc.py&lt;/i&gt;&#10;threshold &#964; (from checkpoint)&#10;fill holes&#10;drop components &lt; 0.02 mm&#178;&#10;opening with 10 &#181;m disk&#10;ALL in physical units, not px" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="290" y="1475" width="250" height="140" as="geometry" />
        </mxCell>
        <mxCell id="C10" value="Overlay&#10;jet heatmap &#945;=0.45&#10;over thumbnail,&#10;lesion outlines" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="600" y="1485" width="170" height="110" as="geometry" />
        </mxCell>
        <mxCell id="C11" value="Evaluation&#10;&lt;i&gt;eval/&lt;/i&gt;&#10;1. patch Dice / IoU&#10;2. FROC (PRIMARY) &#8212; sensitivity&#10;    @ 0.25/0.5/1/2/4/8 FP per slide&#10;3. slide AUC&#10;+ 1000&#215; slide-level bootstrap CI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="830" y="1465" width="290" height="150" as="geometry" />
